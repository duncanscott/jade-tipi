{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jade-tipi.org/schema/message.schema.json",
  "title": "Message",
  "description": "Kafka message DTO for Jade-Tipi transaction and entity operations",
  "type": "object",
  "required": [
    "txn",
    "uuid",
    "collection",
    "action"
  ],
  "additionalProperties": false,
  "properties": {
    "txn": {
      "$ref": "#/$defs/Transaction"
    },
    "uuid": {
      "$ref": "#/$defs/UUIDv7",
      "description": "UUIDv7 unique to this message"
    },
    "collection": {
      "$ref": "#/$defs/Collection"
    },
    "action": {
      "$ref": "#/$defs/Action"
    },
    "id": {
      "type": "string",
      "description": "Composite message ID: <txn.getId()>~<uuid>~<action>",
      "readOnly": true
    },
    "data": {
      "type": "object",
      "description": "Message-specific payload data. Property names must be snake_case for every collection except the grp permissions map (keyed by world-unique grp IDs) and the prc output_input map (keyed by object IDs)."
    }
  },
  "allOf": [
    {
      "description": "Transaction collection accepts only transaction-control actions.",
      "if": {
        "properties": {
          "collection": {
            "const": "txn"
          }
        },
        "required": [
          "collection"
        ]
      },
      "then": {
        "properties": {
          "action": {
            "enum": [
              "open",
              "rollback",
              "commit"
            ]
          }
        }
      }
    },
    {
      "description": "Non-transaction collections accept only data-mutating actions.",
      "if": {
        "properties": {
          "collection": {
            "enum": [
              "ent",
              "fil",
              "grp",
              "lnk",
              "loc",
              "ppy",
              "prc",
              "tsk",
              "typ",
              "uni",
              "vdn"
            ]
          }
        },
        "required": [
          "collection"
        ]
      },
      "then": {
        "properties": {
          "action": {
            "enum": [
              "create",
              "update",
              "delete"
            ]
          }
        }
      }
    },
    {
      "description": "Pick the data payload schema by collection. grp uses GroupData (permits world-unique grp IDs as permissions map keys); prc uses ProcedureData (permits object IDs as output_input map keys); every other collection uses SnakeCaseObject. In every branch a top-level data.id, when present, must follow the ObjectId convention.",
      "if": {
        "properties": {
          "collection": {
            "const": "grp"
          }
        },
        "required": [
          "collection"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "allOf": [
              {
                "$ref": "#/$defs/GroupData"
              },
              {
                "$ref": "#/$defs/DataWithObjectId"
              }
            ]
          }
        }
      },
      "else": {
        "if": {
          "properties": {
            "collection": {
              "const": "prc"
            }
          },
          "required": [
            "collection"
          ]
        },
        "then": {
          "properties": {
            "data": {
              "allOf": [
                {
                  "$ref": "#/$defs/ProcedureData"
                },
                {
                  "$ref": "#/$defs/DataWithObjectId"
                }
              ]
            }
          }
        },
        "else": {
          "properties": {
            "data": {
              "allOf": [
                {
                  "$ref": "#/$defs/SnakeCaseObject"
                },
                {
                  "$ref": "#/$defs/DataWithObjectId"
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "UUIDv7": {
      "title": "UUIDv7",
      "description": "UUID version 7 (RFC 9562) with embedded timestamp. Version nibble is 7, variant is 1 (8/9/a/b).",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "examples": [
        "018fd849-2a40-7abc-8a45-111111111111"
      ]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Transaction identifier containing UUIDv7, group, and client. ID format: <uuid>~<org>~<grp>~<client>",
      "type": "object",
      "required": [
        "uuid",
        "group",
        "client"
      ],
      "additionalProperties": false,
      "properties": {
        "uuid": {
          "$ref": "#/$defs/UUIDv7",
          "description": "UUIDv7 for the transaction"
        },
        "group": {
          "$ref": "#/$defs/Group"
        },
        "client": {
          "type": "string",
          "minLength": 1,
          "description": "Keycloak client identifier",
          "examples": [
            "jade-cli",
            "tipi-cli"
          ]
        },
        "user": {
          "type": "string",
          "minLength": 1,
          "description": "User identifier"
        }
      }
    },
    "Group": {
      "title": "Group",
      "description": "Organization and group identifiers. ID format: <org>~<grp>",
      "type": "object",
      "required": [
        "org",
        "grp"
      ],
      "additionalProperties": false,
      "properties": {
        "org": {
          "type": "string",
          "minLength": 1,
          "description": "Organization identifier",
          "examples": [
            "jade-tipi-org"
          ]
        },
        "grp": {
          "type": "string",
          "minLength": 1,
          "description": "Group identifier",
          "examples": [
            "dev",
            "production"
          ]
        }
      }
    },
    "Collection": {
      "title": "Collection",
      "description": "Target Jade-Tipi collection abbreviation",
      "type": "string",
      "enum": [
        "ent",
        "fil",
        "grp",
        "lnk",
        "loc",
        "ppy",
        "prc",
        "tsk",
        "txn",
        "typ",
        "uni",
        "vdn"
      ]
    },
    "Action": {
      "title": "Action",
      "description": "Action type for the message",
      "type": "string",
      "enum": [
        "open",
        "rollback",
        "commit",
        "create",
        "update",
        "delete"
      ]
    },
    "SnakeCaseObject": {
      "title": "SnakeCaseObject",
      "description": "Object with snake_case property names (lowercase letters, digits, underscores, starting with a letter)",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/SnakeCaseValue"
      }
    },
    "GroupData": {
      "title": "GroupData",
      "description": "grp create/update payload. Outer property names are snake_case; the optional permissions property is a map keyed by world-unique grp IDs.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "properties": {
        "permissions": {
          "$ref": "#/$defs/Permissions"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/SnakeCaseValue"
      }
    },
    "Permissions": {
      "title": "Permissions",
      "description": "First-pass grp permissions map. Keys are world-unique grp IDs; values are 'rw' (read/write) or 'r' (read-only).",
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "rw",
          "r"
        ]
      }
    },
    "ProcedureData": {
      "title": "ProcedureData",
      "description": "prc payload. Outer property names are snake_case; the optional output_input property is the execution-provenance map keyed by output ent IDs.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "properties": {
        "output_input": {
          "$ref": "#/$defs/OutputInput"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/SnakeCaseValue"
      }
    },
    "OutputInput": {
      "title": "OutputInput",
      "description": "Procedure execution provenance: keys are output ent IDs; each value maps the input ent IDs used to generate that output to an open contribution object (for a pooling procedure, typically the contributed volume). Contribution-object schemas will later be supplied by a vdn record associated with the procedure type.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/$defs/SnakeCaseObject"
        }
      }
    },
    "SnakeCaseValue": {
      "title": "SnakeCaseValue",
      "description": "Value that may contain nested snake_case objects or arrays",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/SnakeCaseObject"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SnakeCaseValue"
          }
        }
      ]
    },
    "ObjectId": {
      "title": "ObjectId",
      "description": "World-unique object identifier per the TASK-044 convention: <org>~<grp>~<uuidv7>~<collection>~<suffix>, where the UUIDv7 is the creating transaction's or message's UUID. The literal genesis segment is sanctioned only for the reserved bootstrap usr. An optional second conforming block tolerates the deprecated legacy composite assignment id, which the materializer ignores.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*~[a-z][a-z0-9_-]*~([0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|genesis)~(ent|fil|ppy|lnk|loc|prc|tsk|uni|grp|typ|vdn|usr)~[a-z0-9_-]+(~[a-z][a-z0-9_-]*~[a-z][a-z0-9_-]*~([0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|genesis)~(ent|fil|ppy|lnk|loc|prc|tsk|uni|grp|typ|vdn|usr)~[a-z0-9_-]+)?$"
    },
    "DataWithObjectId": {
      "title": "DataWithObjectId",
      "description": "Constrains the top-level data.id (when present) to the object identifier convention.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ObjectId"
        }
      }
    }
  },
  "examples": [
    {
      "txn": {
        "uuid": "018fd849-2a40-7abc-8a45-111111111111",
        "group": {
          "org": "jade-tipi-org",
          "grp": "dev"
        },
        "client": "jade-cli"
      },
      "uuid": "018fd849-2a40-7def-8b56-222222222222",
      "collection": "txn",
      "action": "open",
      "data": {
        "description": "importing sample batch"
      }
    },
    {
      "txn": {
        "uuid": "018fd849-2a40-7abc-8a45-111111111111",
        "group": {
          "org": "jade-tipi-org",
          "grp": "dev"
        },
        "client": "jade-cli"
      },
      "uuid": "018fd849-2a41-7123-8c67-333333333333",
      "collection": "ppy",
      "action": "create",
      "data": {
        "kind": "definition",
        "id": "jade-tipi-org~dev~018fd849-2a41-7123-8c67-333333333333~ppy~barcode",
        "name": "barcode",
        "value_schema": {
          "type": "object",
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "txn": {
        "uuid": "018fd849-2a40-7abc-8a45-111111111111",
        "group": {
          "org": "jade-tipi-org",
          "grp": "dev"
        },
        "client": "jade-cli"
      },
      "uuid": "018fd849-2a43-7789-8e89-555555555555",
      "collection": "txn",
      "action": "commit",
      "data": {
        "comment": "batch import complete"
      }
    }
  ]
}
